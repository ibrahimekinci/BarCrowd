<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <action
        android:id="@+id/action_global_to_signInFragment"
        app:destination="@id/signInFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true"/>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_venueDetailsFragment"
            app:destination="@id/venueDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_allVenuesFragment"
            app:destination="@id/allVenuesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_liveUpdateDetailFragment"
            app:destination="@id/liveUpdateDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_allLiveUpdatesFragment"
            app:destination="@id/allLiveUpdatesFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.search.SearchFragment"
        android:label="Search"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_search_to_results"
            app:destination="@id/resultsFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultsFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.search.results.ResultsFragment"
        android:label="Results"
        tools:layout="@layout/fragment_results">
        <argument
            android:name="filterOptions"
            app:argType="com.ibrahimekinci.barcrowd.domain.model.VenueFilterOptions" />
        <action
            android:id="@+id/action_resultsFragment_to_venueDetailsFragment"
            app:destination="@id/venueDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.account.AccountFragment"
        android:label="fragment_account"
        tools:layout="@layout/fragment_account">
        <action
            android:id="@+id/action_accountFragment_to_signInFragment"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_accountFragment_to_contactSupportFragment"
            app:destination="@id/contactSupportFragment" />
        <action
            android:id="@+id/action_accountFragment_to_helpCenterFragment"
            app:destination="@id/helpCenterFragment" />
        <action
            android:id="@+id/action_accountFragment_to_privacyPolicyFragment"
            app:destination="@id/privacyPolicyFragment" />
        <action
            android:id="@+id/action_accountFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

        <action
            android:id="@+id/action_accountFragment_to_myLiveUpdatesFragment"
            app:destination="@id/myLiveUpdatesFragment" />
    </fragment>

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.auth.SignInFragment"
        android:label="fragment_sign_in"
        tools:layout="@layout/fragment_sign_in">
        <action
            android:id="@+id/action_signInFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_signInFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.auth.SignUpFragment"
        android:label="fragment_sign_up"
        tools:layout="@layout/fragment_sign_up">
        <action
            android:id="@+id/action_signUpFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/allVenuesFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.venues.AllVenuesFragment"
        android:label="fragment_all_venues"
        tools:layout="@layout/fragment_all_venues" >
        <action
            android:id="@+id/action_allVenuesFragment_to_venueDetailsFragment"
            app:destination="@id/venueDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/newLiveUpdateFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.liveupdate.post.NewLiveUpdateFragment"
        android:label="fragment_new_live_update"
        tools:layout="@layout/fragment_new_live_update">
        <argument
            android:name="venueId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/venueDetailsFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.venues.VenueDetailsFragment"
        android:label="fragment_venue_details"
        tools:layout="@layout/fragment_venue_details">
        <argument
            android:name="venueId"
            app:argType="string" />

        <action
            android:id="@+id/action_venueDetailsFragment_to_newLiveUpdateFragment"
            app:destination="@id/newLiveUpdateFragment" />

        <action
            android:id="@+id/action_venueDetailsFragment_to_liveUpdateDetailFragment"
            app:destination="@id/liveUpdateDetailFragment" />

        <action
            android:id="@+id/action_venueDetailsFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
    </fragment>

    <fragment
        android:id="@+id/liveUpdateDetailFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.liveupdate.details.LiveUpdateDetailFragment"
        android:label="fragment_live_update_detail"
        tools:layout="@layout/fragment_live_update_detail">
        <argument
            android:name="liveUpdate"
            app:argType="com.ibrahimekinci.barcrowd.domain.model.LiveUpdate" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.account.profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/contactSupportFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.info.ContactSupportFragment"
        android:label="fragment_contact_support"
        tools:layout="@layout/fragment_contact_support" />
    <fragment
        android:id="@+id/privacyPolicyFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.info.PrivacyPolicyFragment"
        android:label="fragment_privacy_policy"
        tools:layout="@layout/fragment_privacy_policy" />
    <fragment
        android:id="@+id/helpCenterFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.info.HelpCenterFragment"
        android:label="fragment_help_center"
        tools:layout="@layout/fragment_help_center" />

    <fragment
        android:id="@+id/myLiveUpdatesFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.liveupdate.myliveupdate.MyLiveUpdatesFragment"
        android:label="My Live Updates"
        tools:layout="@layout/fragment_my_live_updates">

        <action
            android:id="@+id/action_myLiveUpdates_to_detail"
            app:destination="@id/liveUpdateDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/allLiveUpdatesFragment"
        android:name="com.ibrahimekinci.barcrowd.ui.liveupdate.feed.AllLiveUpdatesFragment"
        android:label="All Live Updates"
        tools:layout="@layout/fragment_all_live_updates">

        <action
            android:id="@+id/action_allLiveUpdates_to_detail"
            app:destination="@id/liveUpdateDetailFragment" />
    </fragment>
</navigation>