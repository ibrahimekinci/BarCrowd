    <!-- Privacy Policy Page -->
    <string name="privacy_title_welcome">Welcome to BarCrowd</string>
    <string name="privacy_last_updated">Last updated: 1 November 2025</string>
    <string name="privacy_intro">Your privacy is important to us. This Privacy Policy explains how we collect, use, and protect your information when you use the BarCrowd application.</string>
    <string name="privacy_title_collection">Information We Collect</string>
    <string name="privacy_collection_body">
        <b>Personal Information:</b> Your name, email address, and profile picture (if provided). Account credentials.\n
        <b>Usage Information:</b> Venues you view or interact with, content you upload (photos, videos, crowd data).\n
        <b>Location Data:</b> We only collect your location if you explicitly grant permission, which is required to tag your live updates accurately.
    </string>
    <string name="privacy_title_usage">How We Use Your Information</string>
    <string name="privacy_usage_body">
        - To provide and improve app features.\n
        - To display your crowd updates to other users.\n
        - To personalize your experience.\n
        - To analyze app usage and trends to improve our service.
    </string>
    <string name="privacy_title_ugc">User-Submitted Content</string>
    <string name="privacy_ugc_body">When you upload a crowd update (photo or video), your content, username, and the time of submission may be visible to other users of the app. By submitting content, you grant BarCrowd a license to display it.</string>

    <!-- Help Center (FAQ) Page -->
    <string name="faq_q1">What is BarCrowd?</string>
    <string name="faq_a1">BarCrowd is a mobile app that lets users check real-time crowd levels at bars and clubs through photos and videos shared by other users.</string>
    <string name="faq_q2">What does "Crowd Level" mean?</string>
    <string name="faq_a2">
        <b>Low:</b> Mostly empty or very few people. Plenty of space, no wait at the bar.\n
        <b>Medium:</b> Moderately busy, but not packed. Still easy to move around.\n
        <b>High:</b> Very busy or packed. Hard to find space, possible wait time to enter.
    </string>
    <string name="faq_q3">How do I upload a crowd update?</string>
    <string name="faq_a3">Tap the "New Live Update" icon on the bottom navigation bar. Select a venue, capture or upload a photo/video, set the crowd level, wait time, and age range, then tap "Publish Update".</string>
    <string name="faq_q4">Can I delete an update I posted?</string>
    <string name="faq_a4">Yes. Go to Account > My Live Updates. You will find a list of your contributions with an option to delete them.</string>
    <string name="faq_q5">How do I contact support?</string>
    <string name="faq_a5">For help or account-related questions, please email us at support@barcrowd.app. We typically respond within 24-48 hours.</string>

